{
  "name": "MT5 Bot Dashboard",
  "short_name": "MT5 Bots",
  "description": "Welcher Bot macht Gewinn, welcher Verlust – alle MetaTrader 5-Konten auf einen Blick.",
  "lang": "de",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c061c",
  "theme_color": "#120827",
  "icons": [
